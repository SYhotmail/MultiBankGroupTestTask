      },
      "comment" : "Description of NFLX on the symbol detail screen."
    },
    "Leading provider of cloud-based customer relationship management software." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مزوّد رائد لبرمجيات إدارة علاقات العملاء المعتمدة على السحابة."
