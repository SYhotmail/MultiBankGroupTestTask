    },
    "Designs CPUs, GPUs and adaptive chips for PCs, consoles and data centers." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تصمّم المعالجات المركزية ووحدات معالجة الرسومات والرقائق التكيفية للحواسيب ومنصات الألعاب ومراكز البيانات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entwickelt CPUs, GPUs und adaptive Chips für PCs, Spielkonsolen und Rechenzentren."
          }
        }
      },
      "comment" : "Description of AMD on the symbol detail screen."
    },
    "Designs GPUs and accelerated computing platforms that power gaming, data centers and AI workloads." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تصمّم وحدات معالجة الرسومات ومنصات الحوسبة المسرّعة التي تشغّل الألعاب ومراكز البيانات وأعباء الذكاء الاصطناعي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entwickelt GPUs und Plattformen für beschleunigtes Rechnen für Gaming, Rechenzentren und KI-Anwendungen."
          }
        }
      },
      "comment" : "Description of NVDA on the symbol detail screen."
    },
    "Designs and manufactures processors and offers foundry services for third-party chip designers." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تصمّم المعالجات وتصنّعها، وتقدّم خدمات التصنيع لمصمّمي الرقائق من جهات أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entwickelt und fertigt Prozessoren und bietet Foundry-Dienste für externe Chipentwickler an."
          }
        }
      },
      "comment" : "Description of INTC on the symbol detail screen."
    },
    "Designs and sells iPhone, Mac, iPad, wearables and a growing portfolio of services such as the App Store, iCloud and Apple Music." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تصمّم وتبيع iPhone وMac وiPad والأجهزة القابلة للارتداء ومجموعة متنامية من الخدمات مثل App Store وiCloud وApple Music."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entwickelt und verkauft iPhone, Mac, iPad, Wearables und ein wachsendes Angebot an Diensten wie App Store, iCloud und Apple Music."
          }
        }
      },
      "comment" : "Description of AAPL on the symbol detail screen."
    },
    "Designs semiconductors for networking and storage, and sells infrastructure software." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تصمّم أشباه الموصلات للشبكات والتخزين، وتبيع برمجيات البنية التحتية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entwickelt Halbleiter für Netzwerke und Speicher und verkauft Infrastruktursoftware."
          }
        }
      },
      "comment" : "Description of AVGO on the symbol detail screen."
    },
    "Designs wireless and mobile chipsets and licenses foundational cellular technology." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تصمّم شرائح الاتصالات اللاسلكية والأجهزة المحمولة وترخّص تقنيات الاتصالات الخلوية الأساسية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entwickelt Chipsätze für Mobilgeräte und Funk und lizenziert grundlegende Mobilfunktechnologie."
          }
        }
      },
      "comment" : "Description of QCOM on the symbol detail screen."
    },
    "Develops Windows, Office and the Azure cloud platform, and owns LinkedIn, GitHub and Xbox." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تطوّر Windows وOffice ومنصة Azure السحابية، وتملك LinkedIn وGitHub وXbox."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entwickelt Windows, Office und die Cloud-Plattform Azure und besitzt LinkedIn, GitHub und Xbox."
          }
        }
      },
      "comment" : "Description of MSFT on the symbol detail screen."
    },
    "Disconnected" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "غير متصل"
