        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Führender Anbieter cloudbasierter Software für das Kundenbeziehungsmanagement."
          }
        }
      },
      "comment" : "Description of CRM on the symbol detail screen."
    },
    "Live prices are unavailable. The app will keep trying to reconnect." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الأسعار المباشرة غير متاحة. سيواصل التطبيق محاولة إعادة الاتصال."
