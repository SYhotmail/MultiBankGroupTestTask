    },
    "Entertainment company spanning studios, theme parks, ESPN and the Disney+ streaming service." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شركة ترفيه تضم استوديوهات أفلام ومدن ملاهٍ وESPN وخدمة البث Disney+."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unterhaltungskonzern mit Filmstudios, Freizeitparks, ESPN und dem Streamingdienst Disney+."
          }
        }
      },
      "comment" : "Description of DIS on the symbol detail screen."
    },
    "Global payments technology company connecting consumers, merchants and banks." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شركة عالمية لتقنيات الدفع تربط المستهلكين والتجار والبنوك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Globales Zahlungstechnologieunternehmen, das Verbraucher, Händler und Banken verbindet."
          }
        }
      },
      "comment" : "Description of MA on the symbol detail screen."
    },
    "Global subscription streaming service for films, series and games." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خدمة بث عالمية بالاشتراك للأفلام والمسلسلات والألعاب."
