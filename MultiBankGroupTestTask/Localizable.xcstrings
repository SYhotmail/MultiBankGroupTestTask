        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live-Kurse sind nicht verfügbar. Die App versucht weiterhin, die Verbindung wiederherzustellen."
          }
        }
      }
    },
    "Makes creative and document software including Photoshop, Premiere Pro and Acrobat." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تطوّر برمجيات التصميم والمستندات مثل Photoshop وPremiere Pro وAcrobat."
