      "comment" : "Description of WMT on the symbol detail screen."
    },
    "Parent company of Google, operating Search, YouTube, Android, Google Cloud and the Waymo autonomous driving unit." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
