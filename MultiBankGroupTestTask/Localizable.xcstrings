    "Produces and markets beverage brands sold in more than 200 countries." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تنتج وتسوّق علامات مشروبات تُباع في أكثر من 200 دولة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Produziert und vermarktet Getränkemarken, die in über 200 Ländern verkauft werden."
          }
        }
